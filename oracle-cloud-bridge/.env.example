# Environment Configuration for Oracle Cloud Bridge
# Copy this file to .env and update values

# Backend API URL (your Render deployment)
BACKEND_URL=https://shepherd-ai-backend.onrender.com

# Connection code for bridge authentication
CONNECTION_CODE=1DCFEA1A

# Server port (Oracle Cloud - use 3001)
PORT=3001

# WebSocket port for real-time updates
WS_PORT=3002

# Chrome/Chromium path (auto-detected on most systems)
# CHROME_PATH=/usr/bin/chromium-browser

# Node environment
NODE_ENV=production
